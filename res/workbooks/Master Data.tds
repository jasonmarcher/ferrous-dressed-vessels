  <object-graph>
    <objects>
      <object caption='Migrated Data' id='Migrated Data'>
        <properties context=''>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[ship-namesake.csv].[Namesake]' />
                <expression op='[namesake.csv].[Namesake]' />
              </expression>
            </clause>
            <relation join='left' type='join'>
              <clause type='join'>
                <expression op='AND'>
                  <expression op='='>
                    <expression op='[history.csv].[HullID]' />
                    <expression op='[ship-namesake.csv].[HullID]' />
                  </expression>
                  <expression op='='>
                    <expression op='[history.csv].[ShipName]' />
                    <expression op='[ship-namesake.csv].[ShipName]' />
                  </expression>
                </expression>
              </clause>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[fitting-battery.csv].[AmmoID]' />
                    <expression op='[ammo.csv].[AmmoID]' />
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[gun-mounts.csv].[GunID]' />
                      <expression op='[guns.csv].[GunID]' />
                    </expression>
                  </clause>
                  <relation join='left' type='join'>
                    <clause type='join'>
                      <expression op='='>
                        <expression op='[batteries.csv].[GunMountID]' />
                        <expression op='[gun-mounts.csv].[GunMountID]' />
                      </expression>
                    </clause>
                    <relation join='left' type='join'>
                      <clause type='join'>
                        <expression op='='>
                          <expression op='[fitting-battery.csv].[BatteryID]' />
                          <expression op='[batteries.csv].[BatteryID]' />
                        </expression>
