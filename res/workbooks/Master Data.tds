  <column caption='Service Value' datatype='real' name='[Calculation_1113796514602864640]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [State] = &quot;Active&quot; OR [State] = &quot;Training&quot; THEN&#13;&#10;    1 * [WeightedTime]&#13;&#10;ELSE&#13;&#10;    -1 * [WeightedTime]&#13;&#10;END' />
  </column>
  <column caption='Displacement' datatype='real' name='[Calculation_2027464263615545344]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [FullDisplacement] &gt; 0 THEN&#13;&#10;    [FullDisplacement]&#13;&#10;ELSEIF [StandardDisplacement] &gt; 0 THEN&#13;&#10;    [StandardDisplacement] * 1.1&#13;&#10;END' />
  </column>
  <column caption='Ship Broadside Weight Per Minute' datatype='real' name='[Calculation_2291206376785285120]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [HullID] : SUM([Calculation_3021633900066021376]) }' />
  </column>
  <column caption='Ship Battery Broadside Weight Per Minute' datatype='real' name='[Calculation_3021633900066021376]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [HullID], [BatteryID] : AVG([BroadsideArc] * [NumberOfGuns] * [SurfaceShellWeight] * [GunNominalRateOfFire]) }' />
  </column>
  <column caption='Alaska Comparison' datatype='string' name='[Calculation_719450077487468544]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [ClassID] == &quot;cb-alaska&quot; THEN&#13;&#10;    &quot;Alaska&quot;&#13;&#10;ELSE&#13;&#10;    [SubType]&#13;&#10;END' />
  </column>
